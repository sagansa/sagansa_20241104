  <defs>
    <!-- Base gold gradient (shiny effect with bright highlight) -->
    <linearGradient id="gold" x1="0" y1="0" x2="0.5" y2="1">
      <stop offset="0" stop-color="#a06a00"/>
      <stop offset="0.15" stop-color="#f7c940"/>
      <stop offset="0.3" stop-color="#ffea8a"/>
      <stop offset="0.45" stop-color="#ffd54a"/>
      <stop offset="0.6" stop-color="#dba000"/>
      <stop offset="0.75" stop-color="#ffe066"/>
      <stop offset="0.9" stop-color="#c88a00"/>
      <stop offset="1" stop-color="#7a4800"/>
    </linearGradient>
    <!-- Shine highlight (radial) -->
    <radialGradient id="shine" cx="0.3" cy="0.25" r="0.7">
      <stop offset="0" stop-color="#ffffff" stop-opacity="0.55"/>
      <stop offset="0.3" stop-color="#fff8e0" stop-opacity="0.25"/>
      <stop offset="0.7" stop-color="#ffffff" stop-opacity="0"/>
    </radialGradient>
    <!-- Edge stroke -->
    <linearGradient id="goldEdge" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#fff3a5"/>
      <stop offset="0.45" stop-color="#c98200"/>
      <stop offset="1" stop-color="#5d3300"/>
    </linearGradient>
    <!-- Drop shadow filter for depth -->
    <filter id="glow" x="-10%" y="-10%" width="120%" height="120%">
      <feGaussianBlur stdDeviation="6" result="blur"/>
      <feFlood flood-color="#ffb800" flood-opacity="0.3"/>
      <feComposite in2="blur" operator="in" result="glow"/>
      <feMerge>
        <feMergeNode in="glow"/>
        <feMergeNode in="SourceGraphic"/>
      </feMerge>
    </filter>
    <style>
      @media (prefers-color-scheme: dark) {
        .bg-rect { fill: #0a0a0a; opacity: 1; }
        .border-rect { stroke: #ffffff; stroke-width: 24; opacity: 1; }
      }
      @media (prefers-color-scheme: light) {
        .bg-rect { fill: transparent; opacity: 0; }
        .border-rect { stroke: #000000; stroke-width: 24; opacity: 1; }
      }
    </style>
  </defs>

